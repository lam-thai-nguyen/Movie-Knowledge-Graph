@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix kg: <https://example.org/ontology/> .

<https://example.org/ontology/movie-knowledge-graph>
    a owl:Ontology ;
    rdfs:label "Movie Knowledge Graph Ontology"@en ;
    rdfs:comment "An OWL ontology for the movie RDF dataset generated from TMDB data. It reuses Schema.org classes and properties."@en ;
    owl:versionInfo "1.0.0" .

#################################################################
# Classes
#################################################################

schema:Movie
    a owl:Class ;
    rdfs:subClassOf schema:CreativeWork ;
    rdfs:label "Movie"@en ;
    rdfs:comment "A motion picture represented in the movie knowledge graph."@en ;
    owl:disjointWith schema:Person, schema:Genre, schema:Country,
        schema:Language, schema:Organization, schema:AggregateRating,
        schema:Role .

schema:Person
    a owl:Class ;
    rdfs:subClassOf schema:Thing ;
    rdfs:label "Person"@en ;
    rdfs:comment "An actor, director, or other movie crew member."@en .

schema:Role
    a owl:Class ;
    rdfs:subClassOf schema:Intangible ;
    rdfs:label "Acting role"@en ;
    rdfs:comment "A reified acting role connecting a movie, an actor, a character name, and cast position."@en ;
    owl:disjointWith schema:Movie, schema:Person, schema:Genre,
        schema:Country, schema:Language, schema:Organization,
        schema:AggregateRating .

schema:Genre
    a owl:Class ;
    rdfs:subClassOf schema:Intangible ;
    rdfs:label "Genre"@en ;
    rdfs:comment "A genre assigned to a movie."@en ;
    owl:disjointWith schema:Person, schema:Country, schema:Language,
        schema:Organization, schema:AggregateRating .

schema:Country
    a owl:Class ;
    rdfs:subClassOf schema:Thing ;
    rdfs:label "Country"@en ;
    rdfs:comment "A country of origin for a movie or production company."@en ;
    owl:disjointWith schema:Person, schema:Language, schema:Organization,
        schema:AggregateRating .

schema:Language
    a owl:Class ;
    rdfs:subClassOf schema:Intangible ;
    rdfs:label "Language"@en ;
    rdfs:comment "A language associated with a movie."@en ;
    owl:disjointWith schema:Person, schema:Country, schema:Organization,
        schema:AggregateRating .

schema:Organization
    a owl:Class ;
    rdfs:subClassOf schema:Thing ;
    rdfs:label "Production company"@en ;
    rdfs:comment "An organization producing a movie."@en ;
    owl:disjointWith schema:Person, schema:Country, schema:Language,
        schema:AggregateRating .

schema:AggregateRating
    a owl:Class ;
    rdfs:subClassOf schema:Rating ;
    rdfs:label "Aggregate rating"@en ;
    rdfs:comment "An aggregate of the vote value and vote count for a movie."@en ;
    owl:disjointWith schema:Movie, schema:Person, schema:Genre,
        schema:Country, schema:Language, schema:Organization, schema:Role .

#################################################################
# Object properties
#################################################################

schema:actor
    a owl:ObjectProperty ;
    rdfs:label "actor"@en ;
    rdfs:comment "Links a movie to an actor or reified role, and links a reified role to its actor."@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( schema:Movie schema:Role )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf ( schema:Person schema:Role )
    ] .

schema:aggregateRating
    a owl:ObjectProperty ;
    rdfs:label "aggregate rating"@en ;
    rdfs:domain schema:Movie ;
    rdfs:range schema:AggregateRating .

schema:contributor
    a owl:ObjectProperty ;
    rdfs:label "contributor"@en ;
    rdfs:comment "Links a movie to a non-director crew member."@en ;
    rdfs:domain schema:Movie ;
    rdfs:range schema:Person .

schema:countryOfOrigin
    a owl:ObjectProperty ;
    rdfs:label "country of origin"@en ;
    rdfs:domain schema:Movie ;
    rdfs:range schema:Country .

schema:director
    a owl:ObjectProperty ;
    rdfs:label "director"@en ;
    rdfs:domain schema:Movie ;
    rdfs:range schema:Person .

schema:genre
    a owl:ObjectProperty ;
    rdfs:label "genre"@en ;
    rdfs:domain schema:Movie ;
    rdfs:range schema:Genre .

schema:inLanguage
    a owl:ObjectProperty ;
    rdfs:label "in language"@en ;
    rdfs:domain schema:Movie ;
    rdfs:range schema:Language .

schema:location
    a owl:ObjectProperty ;
    rdfs:label "location"@en ;
    rdfs:comment "Links a production company to its origin country."@en ;
    rdfs:domain schema:Organization ;
    rdfs:range schema:Country .

schema:productionCompany
    a owl:ObjectProperty ;
    rdfs:label "production company"@en ;
    rdfs:domain schema:Movie ;
    rdfs:range schema:Organization .

kg:directedMovie
    a owl:ObjectProperty ;
    rdfs:label "directed movie"@en ;
    rdfs:domain schema:Person ;
    rdfs:range schema:Movie ;
    owl:inverseOf schema:director .

kg:productionCountry
    a owl:ObjectProperty ;
    rdfs:label "production country"@en ;
    rdfs:domain schema:Movie ;
    rdfs:range schema:Country ;
    owl:propertyChainAxiom (
        schema:productionCompany
        schema:location
    ) .

kg:imdbPage
    a owl:ObjectProperty,
        owl:FunctionalProperty,
        owl:InverseFunctionalProperty ;
    rdfs:label "IMDb page"@en ;
    rdfs:domain schema:Movie ;
    rdfs:range rdfs:Resource .

#################################################################
# Datatype properties
#################################################################

schema:abstract
    a owl:DatatypeProperty ;
    rdfs:label "abstract"@en ;
    rdfs:domain schema:Movie ;
    rdfs:range xsd:string .

schema:characterName
    a owl:DatatypeProperty ;
    rdfs:label "character name"@en ;
    rdfs:domain schema:Role ;
    rdfs:range xsd:string .

schema:datePublished
    a owl:DatatypeProperty ;
    rdfs:label "date published"@en ;
    rdfs:domain schema:Movie ;
    rdfs:range xsd:date .

schema:duration
    a owl:DatatypeProperty ;
    rdfs:label "duration"@en ;
    rdfs:domain schema:Movie ;
    rdfs:range xsd:duration .

schema:identifier
    a owl:DatatypeProperty ;
    rdfs:label "identifier"@en ;
    rdfs:domain schema:Movie ;
    rdfs:range xsd:string .

schema:name
    a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( schema:Movie schema:Person schema:Genre
            schema:Country schema:Language schema:Organization )
    ] ;
    rdfs:range xsd:string .

schema:position
    a owl:DatatypeProperty ;
    rdfs:label "cast position"@en ;
    rdfs:domain schema:Role ;
    rdfs:range xsd:integer .

schema:ratingCount
    a owl:DatatypeProperty ;
    rdfs:label "rating count"@en ;
    rdfs:domain schema:AggregateRating ;
    rdfs:range xsd:integer .

schema:ratingValue
    a owl:DatatypeProperty ;
    rdfs:label "rating value"@en ;
    rdfs:domain schema:AggregateRating ;
    rdfs:range xsd:decimal .

schema:roleName
    a owl:DatatypeProperty ;
    rdfs:label "role name"@en ;
    rdfs:comment "The job title of a non-director crew member."@en ;
    rdfs:domain schema:Person ;
    rdfs:range xsd:string .

schema:sameAs
    a owl:ObjectProperty ;
    rdfs:label "same as"@en ;
    rdfs:domain schema:Movie ;
    rdfs:range rdfs:Resource ;
    a owl:SymmetricProperty .

#################################################################
# OWL restrictions
#################################################################

schema:Movie
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty schema:name ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger
        ],
        [ a owl:Restriction ;
          owl:onProperty schema:identifier ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger
        ],
        [ a owl:Restriction ;
          owl:onProperty schema:aggregateRating ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger
        ] .

schema:Role
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty schema:actor ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass schema:Person
        ],
        [ a owl:Restriction ;
          owl:onProperty schema:characterName ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger
        ],
        [ a owl:Restriction ;
          owl:onProperty schema:position ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger
        ] .

schema:AggregateRating
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty schema:ratingValue ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger
        ],
        [ a owl:Restriction ;
          owl:onProperty schema:ratingCount ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger
        ] .
